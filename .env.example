# Server-side only. Never expose these in frontend code.
DATABASE_URL=postgres://...
SESSION_SECRET=change-me

# AI provider: set ONE key. Gemini has a free tier (aistudio.google.com/apikey).
GEMINI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# FOODVERSE_AI_PROVIDER=gemini      # gemini | xai | anthropic (needed only if several keys are set)
# FOODVERSE_AI_MODEL=               # override the provider's default model (must support images + tool calling)
# FOODVERSE_AI_TIMEOUT=90
# FOODVERSE_AI_RATE_LIMIT=30
# USDA_API_KEY=
